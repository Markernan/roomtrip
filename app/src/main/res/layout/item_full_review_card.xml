<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Circle Avatar -->
        <TextView
            android:id="@+id/tvAvatarInitials"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_tab_container"
            android:gravity="center"
            android:text="CR"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Nombre -->
        <TextView
            android:id="@+id/tvReviewerName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="Carlos Ruiz"
            android:textColor="@color/text_dark"
            android:textSize="15sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/tvStars"
            app:layout_constraintStart_toEndOf="@id/tvAvatarInitials"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Subtítulo: Habitación y tiempo -->
        <TextView
            android:id="@+id/tvReviewMeta"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Hab. 308 • Hace 2 días"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            app:layout_constraintEnd_toStartOf="@id/tvStars"
            app:layout_constraintStart_toStartOf="@id/tvReviewerName"
            app:layout_constraintTop_toBottomOf="@id/tvReviewerName" />

        <!-- Estrellas (texto simulado de estrellas doradas) -->
        <TextView
            android:id="@+id/tvStars"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="★★★★★"
            android:textColor="#F59E0B"
            android:textSize="14sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Comentario de la reseña -->
        <TextView
            android:id="@+id/tvCommentText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Excelente atención y limpieza. La habitación estaba impecable y el personal fue muy amable durante toda nuestra estancia."
            android:textColor="@color/text_dark"
            android:textSize="13sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvAvatarInitials" />

        <!-- Tag de 'Respondido por el hotel' -->
        <TextView
            android:id="@+id/tvRespondedTag"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_responded_tag"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:text="✓ Respondido por el hotel"
            android:textColor="@color/primary_teal"
            android:textSize="12sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/tvCommentText" />

        <!-- Botón 'Responder' (visible si no se ha respondido aún) -->
        <TextView
            android:id="@+id/btnRespond"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_btn_respond"
            android:paddingHorizontal="16dp"
            android:paddingVertical="6dp"
            android:text="Responder"
            android:textColor="@color/primary_teal"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvCommentText" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>