<?xml version="1.0" encoding="utf-8"?>
<!-- Lab 6: opiniones reales del hotel (colección valoraciones, se crean en el checkout) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:id="@+id/tvCalificacionGeneral"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/detalle_calificacion_general"
        android:textColor="@color/texto_principal"
        android:textSize="16sp"
        android:fontFamily="@font/poppins_semibold" />

    <TextView
        android:id="@+id/tvNumOpiniones"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/texto_secundario"
        android:textSize="12sp"
        android:fontFamily="@font/poppins_regular" />

    <LinearLayout
        android:id="@+id/contenedorOpiniones"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="vertical" />

</LinearLayout>
