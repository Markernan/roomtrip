<?xml version="1.0" encoding="utf-8"?>
<!-- Tarjeta de un servicio finalizado en HistorialServiciosActivity (taxista). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_tarjeta_blanca"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvNombrePasajero"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/poppins_bold"
            android:textColor="@color/texto_principal"
            android:textSize="14sp"
            tools:text="Carlos Mendoza" />

        <TextView
            android:id="@+id/tvEstado"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill_green"
            android:fontFamily="@font/poppins_semibold"
            android:paddingHorizontal="10dp"
            android:paddingVertical="2dp"
            android:textColor="@color/verde_texto"
            android:textSize="11sp"
            tools:text="Finalizado" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvOrigen"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/texto_secundario"
        android:textSize="12sp"
        tools:text="Origen: Hotel La Dolce Vita" />

    <TextView
        android:id="@+id/tvDestino"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/texto_secundario"
        android:textSize="12sp"
        tools:text="Destino: Aeropuerto Jorge Chávez" />

    <TextView
        android:id="@+id/tvFecha"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:fontFamily="@font/poppins_medium"
        android:textColor="@color/texto_secundario"
        android:textSize="11sp"
        tools:text="19/10/2026 14:30" />
</LinearLayout>
