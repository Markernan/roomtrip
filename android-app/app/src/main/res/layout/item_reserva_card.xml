<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_tarjeta_blanca"
    android:padding="12dp"
    android:layout_marginBottom="16dp">

    <ImageView
        android:id="@+id/ivFotoReserva"
        android:layout_width="match_parent"
        android:layout_height="140dp"
        android:scaleType="centerCrop"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="10dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:id="@+id/tvNombreHotelReserva"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hotel Larco Suites"
                android:textColor="@color/texto_principal"
                android:textSize="16sp"
                android:fontFamily="@font/poppins_semibold" />
            <TextView
                android:id="@+id/tvUbicacionReserva"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Lima, Perú · 4.5 estrellas"
                android:textColor="@color/texto_secundario"
                android:textSize="12sp"
                android:fontFamily="@font/poppins_regular" />
        </LinearLayout>

        <Button
            android:id="@+id/btnContactar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingHorizontal="20dp"
            android:paddingVertical="8dp"
            android:text="Contactar"
            android:textSize="12sp"
            style="@style/Boton.Primario" />
    </LinearLayout>

    <Button
        android:id="@+id/btnHacerCheckout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:minHeight="0dp"
        android:paddingVertical="10dp"
        android:text="Hacer checkout"
        android:textSize="13sp"
        style="@style/Boton.Outline" />

</LinearLayout>
