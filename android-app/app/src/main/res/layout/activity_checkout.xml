<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo_pantalla">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"
            android:text="RoomTrip"
            android:textColor="@color/texto_principal"
            android:textSize="18sp"
            android:fontFamily="@font/poppins_bold" />

        <!-- RF-CL-05: notificación del cobro final -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_notificacion_oscura"
            android:padding="14dp">
            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_notification"
                android:contentDescription="@null" />
            <TextView
                android:id="@+id/tvNotificacionCobro"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:text="Notificación: Cobro final realizado por $83"
                android:textColor="@color/blanco"
                android:textSize="12sp"
                android:fontFamily="@font/poppins_medium" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Resumen de Estadía: 3 Noches"
            android:textColor="@color/texto_principal"
            android:textSize="16sp"
            android:fontFamily="@font/poppins_semibold" />

        <!-- RF-CL-04: valoración y observaciones obligatorias -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Valoración Obligatoria (*)"
            android:textColor="@color/texto_principal"
            android:textSize="13sp"
            android:fontFamily="@font/poppins_semibold" />

        <RatingBar
            android:id="@+id/ratingBarEstadia"
            style="?android:attr/ratingBarStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:numStars="5"
            android:rating="4"
            android:progressTint="@color/amarillo_estrella" />

        <EditText
            android:id="@+id/etObservaciones"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input_texto"
            android:gravity="top|start"
            android:padding="12dp"
            android:hint="Observaciones de la estadía..."
            android:textColorHint="@color/texto_secundario"
            android:textColor="@color/texto_principal"
            android:textSize="13sp"
            android:fontFamily="@font/poppins_regular" />

        <!-- RF-CL-08 / RF-AH-10: taxi gratuito si se alcanza el monto mínimo -->
        <LinearLayout
            android:id="@+id/cajaTaxiGratis"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_caja_verde_claro"
            android:padding="14dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="¡Felicidades! Calificas para taxi gratis."
                android:textColor="@color/verde_texto"
                android:textSize="13sp"
                android:fontFamily="@font/poppins_semibold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Monto mínimo de consumo alcanzado."
                android:textColor="@color/verde_texto"
                android:textSize="12sp"
                android:fontFamily="@font/poppins_regular" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="Solicitar traslado:"
                android:textColor="@color/texto_principal"
                android:textSize="13sp"
                android:fontFamily="@font/poppins_medium" />

            <Spinner
                android:id="@+id/spinnerAeropuerto"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_input_texto"
                android:paddingHorizontal="12dp" />

            <Button
                android:id="@+id/btnSolicitarTaxi"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:text="Solicitar taxi"
                android:background="@drawable/bg_boton_verde"
                android:textColor="@color/blanco"
                android:textAllCaps="false"
                android:fontFamily="@font/poppins_semibold" />
        </LinearLayout>

        <Button
            android:id="@+id/btnFinalizarCheckout"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:text="Finalizar checkout"
            style="@style/Boton.Primario" />

    </LinearLayout>
</ScrollView>
