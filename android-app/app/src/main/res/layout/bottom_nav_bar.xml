<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@color/blanco"
    android:paddingVertical="12dp"
    android:elevation="8dp">

    <LinearLayout
        android:id="@+id/navExplorar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true">
        <ImageView
            android:id="@+id/ivNavExplorar"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_explore"
            android:tint="@color/turquesa"
            android:contentDescription="@null" />
        <TextView
            android:id="@+id/tvNavExplorar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Explorar"
            android:textColor="@color/turquesa"
            android:textSize="12sp"
            android:fontFamily="@font/poppins_medium" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/navReservas"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true">
        <ImageView
            android:id="@+id/ivNavReservas"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_calendar"
            android:contentDescription="@null" />
        <TextView
            android:id="@+id/tvNavReservas"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Reservas"
            android:textColor="@color/texto_secundario"
            android:textSize="12sp"
            android:fontFamily="@font/poppins_medium" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/navPerfil"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center"
        android:clickable="true"
        android:focusable="true">
        <ImageView
            android:id="@+id/ivNavPerfil"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_person"
            android:contentDescription="@null" />
        <TextView
            android:id="@+id/tvNavPerfil"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Perfil"
            android:textColor="@color/texto_secundario"
            android:textSize="12sp"
            android:fontFamily="@font/poppins_medium" />
    </LinearLayout>

</LinearLayout>
