<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/fondo_pantalla"
    android:gravity="center"
    android:padding="32dp">

    <FrameLayout
        android:layout_width="96dp"
        android:layout_height="96dp"
        android:background="@drawable/bg_circulo_verde">
        <ImageView
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_check_circle"
            android:contentDescription="@null" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvMensajeExito"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:text="¡Tu reserva a La Dolce Vita fue exitosa!"
        android:textColor="@color/texto_principal"
        android:textSize="22sp"
        android:fontFamily="@font/poppins_bold"
        android:gravity="center" />

    <Button
        android:id="@+id/btnVolverAlInicio"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="48dp"
        android:text="Volver al inicio"
        style="@style/Boton.Primario" />

</LinearLayout>
