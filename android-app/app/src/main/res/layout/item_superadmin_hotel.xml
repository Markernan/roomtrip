<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/blanco">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="12dp"
        android:gravity="center_vertical">

        <!-- Left side: Rounded ImageView -->
        <androidx.cardview.widget.CardView
            android:layout_width="80dp"
            android:layout_height="80dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/fondo_pantalla">
            <ImageView
                android:id="@+id/ivHotel"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                tools:src="@drawable/hotel_italia_fachada_calle"
                android:contentDescription="Imagen del hotel" />
        </androidx.cardview.widget.CardView>

        <!-- Middle side -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="8dp">

            <TextView
                android:id="@+id/tvNombreHotel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nombre del Hotel"
                android:textSize="16sp"
                android:fontFamily="@font/poppins_semibold"
                android:textColor="@color/texto_principal"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tvDireccionHotel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ubicación"
                android:textSize="13sp"
                android:textColor="@color/texto_secundario"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginTop="2dp" />

            <!-- Rating Stars row -->
            <LinearLayout
                android:id="@+id/layoutEstrellas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="4dp">
                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_star"
                    app:tint="@color/amarillo_estrella" />
                <TextView
                    android:id="@+id/tvRatingHotel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="4.5"
                    android:textSize="12sp"
                    android:fontFamily="@font/poppins_medium"
                    android:textColor="@color/texto_principal"
                    android:layout_marginStart="4dp" />
            </LinearLayout>

            <!-- Bottom-Middle: Tag/Pill with "Admin: [Name]" -->
            <TextView
                android:id="@+id/tvAdminHotel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Admin: Juan Pérez"
                android:textSize="11sp"
                android:fontFamily="@font/poppins_medium"
                android:textColor="@color/turquesa"
                android:background="@drawable/bg_tag_turquesa"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:layout_marginTop="6dp"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <!-- Right side: Switch/SwitchCompat and vertical 3-dot menu icon -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal">

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switchActivoHotel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:thumbTint="@color/turquesa"
                app:trackTint="@color/cyan_pastel" />

            <ImageView
                android:id="@+id/btnMenuOpciones"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_more_vert"
                android:background="?attr/selectableItemBackgroundBorderless"
                app:tint="@color/texto_secundario"
                android:padding="4dp"
                android:layout_marginTop="4dp"
                android:contentDescription="Opciones" />
        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>