<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/fondo_pantalla">

    <!-- Header: foto + calificación superpuesta + botón volver -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="260dp">

        <ImageView
            android:id="@+id/ivFotoHotel"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/foto_hotel_miraflores"
            android:contentDescription="@null" />

        <ImageView
            android:id="@+id/btnVolver"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_margin="16dp"
            android:padding="6dp"
            android:src="@drawable/ic_arrow_back"
            android:background="@drawable/bg_circulo_boton_enviar"
            android:backgroundTint="@color/blanco"
            android:clickable="true"
            android:focusable="true"
            android:contentDescription="@null" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|start"
            android:layout_margin="16dp"
            android:background="@drawable/bg_chip_blanco"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp">
            <TextView
                android:id="@+id/tvNombreHotel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="La Dolce Vita"
                android:textColor="@color/texto_principal"
                android:textSize="14sp"
                android:fontFamily="@font/poppins_semibold" />
            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_marginStart="6dp"
                android:src="@drawable/ic_star"
                android:contentDescription="@null" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="2dp"
                android:text="4.9"
                android:textColor="@color/texto_principal"
                android:textSize="14sp"
                android:fontFamily="@font/poppins_semibold" />
        </LinearLayout>
    </FrameLayout>

    <!-- Pestañas -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/blanco"
        android:padding="8dp">

        <TextView
            android:id="@+id/tabOpiniones"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:background="@drawable/bg_boton_turquesa"
            android:gravity="center"
            android:paddingVertical="10dp"
            android:text="Opiniones"
            android:textColor="@color/blanco"
            android:textSize="13sp"
            android:fontFamily="@font/poppins_semibold"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/tabDetalles"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:gravity="center"
            android:paddingVertical="10dp"
            android:text="Detalles"
            android:textColor="@color/texto_secundario"
            android:textSize="13sp"
            android:fontFamily="@font/poppins_semibold"
            android:clickable="true"
            android:focusable="true" />

        <TextView
            android:id="@+id/tabServicios"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_margin="4dp"
            android:gravity="center"
            android:paddingVertical="10dp"
            android:text="Servicios"
            android:textColor="@color/texto_secundario"
            android:textSize="13sp"
            android:fontFamily="@font/poppins_semibold"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <include layout="@layout/tab_opiniones" android:id="@+id/contenidoOpiniones" />
            <include layout="@layout/tab_detalles" android:id="@+id/contenidoDetalles" />
            <include layout="@layout/tab_servicios" android:id="@+id/contenidoServicios" />

        </FrameLayout>
    </ScrollView>

    <include layout="@layout/bottom_nav_bar" />

</LinearLayout>
