<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="12dp"
    android:background="@color/blanco"
    android:layout_marginBottom="4dp">

    <View
        android:id="@+id/vIndicator"
        android:layout_width="4dp"
        android:layout_height="match_parent"
        android:background="@color/turquesa"
        android:layout_marginEnd="12dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvLogEvent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Usuario Creado"
            android:textSize="14sp"
            android:fontFamily="@font/poppins_semibold"
            android:textColor="@color/texto_principal" />

        <TextView
            android:id="@+id/tvLogDetail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SuperAdmin creó el hotel 'Miraflores'"
            android:textSize="12sp"
            android:textColor="@color/texto_secundario" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvLogTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="10:45 AM"
        android:textSize="12sp"
        android:textColor="@color/texto_secundario" />

</LinearLayout>